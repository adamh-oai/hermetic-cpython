+
+# Bazel supplies fdo_profile_path as a declared input to compilation actions.
+cc_feature(
+    name = "fdo_optimize",
+    args = [":fdo_optimize_compile_args"],
+    overrides = "@rules_cc//cc/toolchains/features/legacy:fdo_optimize",
+)
+
+cc_args(
+    name = "fdo_optimize_compile_args",
+    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
+    args = ["-fprofile-instr-use={fdo_profile_path}"],
+    format = {"fdo_profile_path": "@rules_cc//cc/toolchains/variables:fdo_profile_path"},
+    requires_not_none = "@rules_cc//cc/toolchains/variables:fdo_profile_path",
+)
 
