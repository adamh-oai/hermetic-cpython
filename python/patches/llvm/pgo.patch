diff --git a/3rd_party/llvm-project/x.x/compiler-rt/compiler-rt.BUILD.bazel b/3rd_party/llvm-project/x.x/compiler-rt/compiler-rt.BUILD.bazel
--- a/3rd_party/llvm-project/x.x/compiler-rt/compiler-rt.BUILD.bazel
+++ b/3rd_party/llvm-project/x.x/compiler-rt/compiler-rt.BUILD.bazel
@@ -11,6 +11,43 @@
 load("@llvm//toolchain/runtimes:cc_unsanitized_library.bzl", "cc_unsanitized_library")
 load("@llvm-project//:vars.bzl", "LLVM_VERSION_MAJOR")
 load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+# The profile runtime must itself be built without instrumentation.
+# The stage-0 wrapper clears user compile/link flags for compiler runtimes.
+cc_library(
+    name = "profile_runtime",
+    srcs = [
+        "lib/profile/GCDAProfiling.c",
+        "lib/profile/InstrProfiling.c",
+        "lib/profile/InstrProfilingInternal.c",
+        "lib/profile/InstrProfilingBuffer.c",
+        "lib/profile/InstrProfilingMerge.c",
+        "lib/profile/InstrProfilingMergeFile.c",
+        "lib/profile/InstrProfilingNameVar.c",
+        "lib/profile/InstrProfilingVersionVar.c",
+        "lib/profile/InstrProfilingWriter.c",
+        "lib/profile/InstrProfilingPlatformLinux.c",
+        "lib/profile/InstrProfilingFile.c",
+        "lib/profile/InstrProfilingRuntime.cpp",
+        "lib/profile/InstrProfilingUtil.c",
+        "lib/profile/InstrProfilingValue.c",
+    ] + glob(["lib/profile/*.h", "include/profile/*.h", "include/profile/*.inc"]),
+    includes = ["include", "lib/profile"],
+    local_defines = [
+        "COMPILER_RT_HAS_ATOMICS=1",
+        "COMPILER_RT_HAS_FCNTL_LCK=1",
+        "COMPILER_RT_HAS_FLOCK=1",
+        "COMPILER_RT_HAS_UNAME=1",
+    ],
+    implementation_deps = ["@kernel_headers", "@glibc//:gnu_libc_headers"],
+    target_compatible_with = ["@platforms//os:linux"],
+)
+
+cc_runtime_stage0_static_library(
+    name = "clang_rt.profile.static",
+    visibility = ["//visibility:public"],
+    deps = [":profile_runtime"],
+)
 
