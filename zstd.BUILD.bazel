# Adapted from the Bazel Central Registry's zstd 1.5.7.bcr.2 build definition:
# https://github.com/bazelbuild/bazel-central-registry/blob/main/modules/zstd/1.5.7.bcr.2/overlay/BUILD.bazel
# Modified for CPython's private source repository and license notice exports.
# The BCR's Apache 2.0 license is in licenses/bcr/LICENSE.
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "lib/common/threading.c",
    "lib/common/xxhash.c",
    "lib/dictBuilder/divsufsort.c",
])

cc_library(
    name = "zstd",
    srcs = glob([
        "lib/common/*.c",
        "lib/common/*.h",
        "lib/compress/*.c",
        "lib/compress/*.h",
        "lib/decompress/*.c",
        "lib/decompress/*.h",
        "lib/dictBuilder/*.c",
        "lib/dictBuilder/*.h",
    ]) + select({
        "@platforms//os:windows": [],
        "//conditions:default": glob(["lib/decompress/*.S"]),
    }),
    hdrs = [
        "lib/zdict.h",
        "lib/zstd.h",
        "lib/zstd_errors.h",
    ],
    includes = ["lib"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    linkstatic = True,
    local_defines = [
        "XXH_NAMESPACE=ZSTD_",
        "ZSTD_MULTITHREAD",
        "ZSTD_BUILD_SHARED=OFF",
        "ZSTD_BUILD_STATIC=ON",
    ] + select({
        "@platforms//os:windows": ["ZSTD_DISABLE_ASM"],
        "//conditions:default": [],
    }),
)
